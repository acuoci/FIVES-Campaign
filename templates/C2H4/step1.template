Dictionary CounterFlowFlame1D
{
	@Type				CounterFlowDiffusion;
	@KineticsFolder		/home/chimica2/cuoci/MyRuns/FIVES/KineticMechanisms/GRI30-noNOX/kinetics-GRI30-noNOX; 
	
	// Output folder
	@Output			Output;

	// Fuel and oxidizer stream data (BCs)
	@FuelStream 		fuel-stream;
	@OxidizerStream		oxidizer-stream;
	@FuelVelocity		$VFUEL$  	cm/s;
	@OxidizerVelocity	$VOX$	cm/s;
	
	// Adaptive grid
	@Grid			grid;	
	
	// First-guess solution data (not very relevant)
	@InitialTemperatureProfile 	T-Profile;	
	@EigenValueStartingGuess	-200 kg/m3/s2;
	@PeakMixture				peak-mixture;
	@InitialProfiles			linear;
	@PeakPosition				1 mm;
	@MixingZoneWidth			3 mm;

	// Numerical parameters
	@UseNlsSolver				false;
	@UseDaeSolver				true;
	@DaeParameters				dae-parameters;

	// Physical sub-models
	@Soret    					true;
	@Radiation					true;
	@EnvironmentTemperature		293 K;
}

Dictionary fuel-stream
{
	@Masses       C2H4 $Y1FUEL$
				  H2O $Y1H2O$
				  O2  $Y1O2$
				  N2  $Y1N2$; 

	@Temperature	$TFUEL$ K;
	@Pressure		1 atm;
}

Dictionary oxidizer-stream
{
	@Masses		H2O	$Y2H2O$
      			O2	$YO2$
      			N2 	$Y2N2$;
					
	@Temperature	$TOX$ K;
	@Pressure		1 atm;
}

Dictionary peak-mixture
{
	@Moles		CO2 0.15 
				H2O 0.15 
				N2  0.70;
					
	@Temperature	2300 K;

	@Pressure	1 atm;
}

Dictionary grid
{
	@Length			1.5 cm;
	@InitialPoints	80;				
	@Type			equispaced;
	
	@MaxPoints				80;		
	@MaxAdaptivePoints		30;
	@GradientCoefficient	0.05;
	@CurvatureCoefficient	0.5;

	@Threshold		1e-5;		
}

Dictionary dae-parameters
{
	@DaeSolver		OpenSMOKE++;
	@RelativeTolerance	1e-6;
	@AbsoluteTolerance	1e-12;
}

