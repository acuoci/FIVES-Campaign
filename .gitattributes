# Normalize text files for consistent diffs across macOS/Linux clusters.
* text=auto eol=lf

# Source code and scripts
*.cpp text eol=lf diff=cpp
*.c   text eol=lf diff=cpp
*.h   text eol=lf diff=cpp
*.hpp text eol=lf diff=cpp
*.py  text eol=lf diff=python
*.sh  text eol=lf

# Project text assets
*.md       text eol=lf
*.txt      text eol=lf
*.template text eol=lf
*.dic      text eol=lf
*.json     text eol=lf
*.csv      text eol=lf
*.xml      text eol=lf

# Binary/generated visual outputs
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary

# Compiled artifacts
*.o     binary
*.obj   binary
*.so    binary
*.dylib binary
*.dll   binary
*.a     binary
*.lib   binary
*.exe   binary
